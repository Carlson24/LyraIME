<resources>
    <style name="Theme.TrimeAppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/text</item>
        <item name="colorPrimaryDark">@color/crust</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:colorAccent">@color/blue</item>
