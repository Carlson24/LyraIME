[submodule "OpenCC"]
	path = app/src/main/jni/OpenCC
	url = https://github.com/BYVoid/OpenCC.git
[submodule "yaml-cpp"]
	path = app/src/main/jni/yaml-cpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "snappy"]
	path = app/src/main/jni/snappy
	url = https://github.com/google/snappy.git
[submodule "leveldb"]
	path = app/src/main/jni/leveldb
	url = https://github.com/google/leveldb.git
[submodule "librime"]
	path = app/src/main/jni/librime
	url = https://github.com/rime/librime.git
	ignore = dirty
[submodule "librime-lua"]
	path = app/src/main/jni/librime-lua
	url = https://github.com/hchunhui/librime-lua.git
	ignore = dirty
[submodule "librime-lua-deps"]
	path = app/src/main/jni/librime-lua-deps
	url = https://github.com/hchunhui/librime-lua.git
	branch = thirdparty
[submodule "librime-octagram"]
	path = app/src/main/jni/librime-octagram
	url = https://github.com/lotem/librime-octagram.git
[submodule "librime-calculator"]
	path = app/src/main/jni/librime-calculator
	url = https://github.com/Carlson24/librime-calculator.git
[submodule "librime-user-predict"]
	path = app/src/main/jni/librime-user-predict
	url = https://github.com/Carlson24/librime-user-predict
[submodule "prelude"]
	path = app/data/rime/prelude
	url = https://github.com/rime/rime-prelude.git
[submodule "luna-pinyin"]
	path = app/data/rime/luna-pinyin
	url = https://github.com/rime/rime-luna-pinyin.git
[submodule "stroke"]
	path = app/data/rime/stroke
	url = https://github.com/rime/rime-stroke.git
[submodule "essay"]
	path = app/data/rime/essay
	url = https://github.com/rime/rime-essay.git
[submodule "sherpa-onnx"]
	path = app/src/main/jni/sherpa-onnx
	url = https://github.com/k2-fsa/sherpa-onnx.git
