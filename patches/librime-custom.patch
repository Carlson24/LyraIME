 }  // anonymous namespace
 
+// Cache SyllableGraph across ScriptTranslator instances.
+// All instances share the same prism and input per key event;
+// caching eliminates 2 of 3 redundant BuildSyllableGraph calls.
+struct SyllableGraphCache {
+  string input;
+  const Prism* prism = nullptr;
+  SyllableGraph graph;
+};
+static thread_local SyllableGraphCache g_syllable_graph_cache;
+
 class ScriptSyllabifier : public PhraseSyllabifier {
  public:
   ScriptSyllabifier(ScriptTranslator* translator,
@@ -365,8 +375,17 @@ Spans ScriptSyllabifier::Syllabify(const Phrase* phrase) {
 }
 
 size_t ScriptSyllabifier::BuildSyllableGraph(Prism& prism) {
-  return (size_t)syllabifier_.BuildSyllableGraph(input_, prism,
-                                                 &syllable_graph_);
+  if (g_syllable_graph_cache.input == input_ &&
+      g_syllable_graph_cache.prism == &prism) {
+    syllable_graph_ = g_syllable_graph_cache.graph;
+    return syllable_graph_.interpreted_length;
+  }
+  size_t result = (size_t)syllabifier_.BuildSyllableGraph(input_, prism,
+                                                          &syllable_graph_);
+  g_syllable_graph_cache.input = input_;
+  g_syllable_graph_cache.prism = &prism;
+  g_syllable_graph_cache.graph = syllable_graph_;
+  return result;
 }
 
