+++ b/sherpa-onnx/csrc/qnn/macros.h
@@ -5,14 +5,32 @@
 #ifndef SHERPA_ONNX_CSRC_QNN_MACROS_H_
 #define SHERPA_ONNX_CSRC_QNN_MACROS_H_
 
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
 #include "sherpa-onnx/csrc/macros.h"
 
+// A QNN fatal error must not call _Exit(): that kills the Android app
+// process before the Kotlin side can catch the failure and fall back to CPU
+// inference. Scope the replacement to QNN translation units, which all
+// include this header, so the rest of sherpa-onnx keeps the upstream behavior.
+#undef SHERPA_ONNX_EXIT
+#define SHERPA_ONNX_EXIT(code)                                   \
+  do {                                                           \
+    throw std::runtime_error("sherpa-onnx QNN fatal error at " + \
+                             std::string(__FILE__) + ":" +       \
+                             std::to_string(__LINE__));          \
+  } while (0)
+
 #define SHERPA_ONNX_QNN_CHECK(ret, msg, ...)                             \
   do {                                                                   \
     if (ret != QNN_SUCCESS) {                                            \
       SHERPA_ONNX_LOGE("Return code is: %d", static_cast<int32_t>(ret)); \
       SHERPA_ONNX_LOGE(msg, ##__VA_ARGS__);                              \
-      SHERPA_ONNX_EXIT(-1);                                              \
+      std::ostringstream oss;                                            \
+      oss << "QNN error " << static_cast<int32_t>(ret) << ": " << msg;   \
+      throw std::runtime_error(oss.str());                               \
     }                                                                    \
   } while (0)
 
